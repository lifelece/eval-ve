# Copia este archivo a .env y rellena los valores.
# .env NUNCA se sube a git.

# --- Fase 3 en adelante (harness) ---
# Claves de las APIs de modelos remotos. Vacias hasta que se necesiten.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Servidor local de LM Studio (compatible con la API de OpenAI), para
# modelos pequenos que quepan en 8 GB de RAM. No es secreta -- es local --
# pero vive aqui por consistencia y porque el host puede cambiar.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
