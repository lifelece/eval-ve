# Copia este archivo a .env y rellena los valores.
# .env NUNCA se sube a git.

# --- Fase 3 en adelante (harness) ---
# Claves de las APIs de modelos remotos. Vacias hasta que se necesiten.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Servidor local de LM Studio (compatible con la API de OpenAI), para
# modelos pequenos que quepan en 8 GB de RAM. No es secreta -- es local --
# pero vive aqui por consistencia y porque el host puede cambiar.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Modelo a usar en LM Studio. Opcional si hay un unico modelo cargado; obligatorio si lista varios.
LMSTUDIO_MODEL=
# Tiempo maximo por llamada local, en milisegundos (modelos chicos en 8 GB pueden tardar).
LMSTUDIO_TIMEOUT_MS=300000
# Alternativa con Ollama (mismo protocolo OpenAI, local, sin coste; sin cambios de codigo). Verificado 2026-10-30:
# LMSTUDIO_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_MODEL=qwen2.5:3b

